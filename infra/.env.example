# Copie para infra/.env e ajuste. NUNCA versionar o .env real (está no .gitignore).
# Segredos aqui são apenas exemplos de DESENVOLVIMENTO — troque em qualquer ambiente real.

# --- PostgreSQL (usados pelo serviço db e para compor a DATABASE_URL) ---
POSTGRES_USER=digitalizador
POSTGRES_PASSWORD=troque_em_dev
POSTGRES_DB=digitalizador

# --- Backend ---
# Host "db" = nome do serviço no docker-compose
DATABASE_URL=postgresql+psycopg://digitalizador:troque_em_dev@db:5432/digitalizador

# Chave de assinatura dos JWT. Gere uma forte, ex.:  openssl rand -hex 32
SECRET_KEY=troque_por_uma_chave_forte_de_32_bytes

ENVIRONMENT=dev
DEBUG=true

# CORS: origens do frontend (JSON array)
CORS_ORIGINS=["http://localhost:5173"]

# --- SMTP (OTP de 2FA / confirmação de e-mail) — preencher quando for integrar ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=nao-responder@bonfim.example

# CORS por regex (dev): libera o frontend acessado por IP na rede, ex.: http://192.168.0.82:5173
CORS_ORIGIN_REGEX=http://[\w.-]+:5173

# DEV ONLY: pula o 2FA e loga direto (ignorado se ENVIRONMENT=prod). Reative com false.
DEV_2FA_BYPASS=false
