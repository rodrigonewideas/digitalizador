# PRODUÇÃO — copie para infra/.env no servidor e ajuste. NUNCA versione o .env real.
#
# Gere os segredos no servidor:
#   openssl rand -hex 32     -> SECRET_KEY
#   openssl rand -hex 16     -> POSTGRES_PASSWORD (use o MESMO valor na DATABASE_URL)

# --- PostgreSQL ---
POSTGRES_USER=digitalizador
POSTGRES_PASSWORD=TROQUE_senha_forte
POSTGRES_DB=digitalizador
DATABASE_URL=postgresql+psycopg://digitalizador:TROQUE_senha_forte@db:5432/digitalizador

# --- Backend ---
SECRET_KEY=TROQUE_por_openssl_rand_hex_32

# Porta HTTP publicada pelo Nginx (frontend). 80 = padrão web.
WEB_PORT=80

# Com Nginx servindo front e API na MESMA origem, o front usa /api/v1 (relativo):
# não é preciso CORS. Deixe vazio.
CORS_ORIGINS=[]
CORS_ORIGIN_REGEX=

# ============================================================================
# PERFIL DE 2FA — escolha UM dos dois blocos abaixo:
#
# (1) PRIMEIRO TESTE, sem SMTP ainda — permite login direto (bypass do 2FA):
ENVIRONMENT=dev
DEBUG=false
DEV_2FA_BYPASS=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=nao-responder@bonfim.example
#
# (2) PRODUÇÃO ENDURECIDA (quando tiver o SMTP) — troque para:
#   ENVIRONMENT=prod
#   DEBUG=false
#   DEV_2FA_BYPASS=false        (ignorado em prod de qualquer forma)
#   SMTP_HOST=smtp.seuprovedor.com.br
#   SMTP_USER=...  SMTP_PASSWORD=...  SMTP_FROM=nao-responder@bonfim.com.br
# ============================================================================

# --- Integração comercial (Firebird "solution"/PDV_BONFIM) — SOMENTE LEITURA ---
# Resolve o terreno (Nº do lote) e o cessionário. Sem preencher, a busca por lote
# apenas não retorna (o resto da consulta funciona). Estas credenciais ficam SÓ
# aqui no .env do servidor (nunca no git).
PDV_FB_HOST=192.168.5.232
PDV_FB_PORT=3050
# Caminho do arquivo NO SERVIDOR Firebird (ou um alias configurado nele).
# Ex. Windows: D:\solution\data\PDV_BONFIM.GDB
PDV_FB_DATABASE=
PDV_FB_USER=SYSDBA
PDV_FB_PASSWORD=
PDV_FB_CHARSET=ISO8859_1
